# Cloudflare 배포 저장소 — 리포트 사이트(report/)와 배포 설정만 추적한다.
# 루트의 나머지(프로젝트.env, node_modules, capture 등)는 전부 제외.
/*
!/.gitignore
!/wrangler.toml
!/report/
!/data/
!/scripts/
.wrangler/
__pycache__/

# 원시 OHLCV 패널은 추적하지 않는다 — 원격이 PUBLIC 이고(데이터 재배포 문제),
# scripts/collect_panel_daily.md 절차로 언제든 재생성된다. 집계 결과만 커밋한다.
/data/panel_daily.csv
/data/panel_*.csv

/data/krx_marketdata.csv
/data/krx_openapi_marketdata.csv
/data/krx_marketdata_full.csv
/data/dart_financials.csv
/data/dart_corpcode.csv
/data/*.bak
/data/dart_accmt.csv

# room_up 광역 수집 원자료 — 원격이 PUBLIC 이라 추적하지 않는다(패널과 같은 이유).
# 유니버스·회차 목록은 재현에 필요하므로 추적한다.
/data/room_up_wide/room_*.json
/data/room_up_wide/BAD_room_*.json
/data/room_up_wide/ohlc*.json
/data/room_up_wide/progress.log
/data/room_up_wide/result.json
/data/room_up_wide/run*.log
/data/room_up_wide/run*.err
/data/room_up_wide/ohlc300_new.json
/data/room_up_wide/*.err
/data/room_up_wide/*.log
